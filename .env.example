# Application
PROOFRUN_APP_NAME=ProofRun
PROOFRUN_ENVIRONMENT=development
PROOFRUN_DEBUG=false

# Nebius Token Factory (do not commit real credentials)
PROOFRUN_NEBIUS_API_KEY=replace-with-nebius-api-key
PROOFRUN_NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
PROOFRUN_NEBIUS_MODEL=nvidia/nvidia-nemotron-3-nano-30b-a3b

# LangSmith (do not commit real credentials)
PROOFRUN_LANGSMITH_TRACING=false
PROOFRUN_LANGSMITH_ENDPOINT=https://api.smith.langchain.com
PROOFRUN_LANGSMITH_API_KEY=replace-with-langsmith-api-key
PROOFRUN_LANGSMITH_PROJECT=proofrun
